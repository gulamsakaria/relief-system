# Copy this file to ".env" and fill in real values for your machine.
# ".env" itself is gitignored — never commit real credentials/salt.
DB_HOST=localhost
DB_NAME=relief_db
DB_USER=root
DB_PASS=
# Must match whatever value was used to pre-compute the nid_hash seed data
# in database.sql, or every demo NID lookup will silently fail to match.
NID_SALT=relief2026_secret_salt
